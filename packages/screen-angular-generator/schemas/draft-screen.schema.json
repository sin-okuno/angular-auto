{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/schemas/draft-screen.schema.json",
  "title": "DraftScreenDocument",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metadata",
    "screen",
    "angular",
    "permissions",
    "operations",
    "fields",
    "apis",
    "types",
    "actions",
    "store",
    "effects",
    "validations",
    "mappers",
    "componentTypes",
    "implementationRules",
    "components",
    "forms",
    "module",
    "routing",
    "tests",
    "displayRules",
    "unsavedChanges",
    "concurrentUpdate",
    "rules",
    "warnings"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parserVersion", "generatedAt", "sourceFiles"],
      "properties": {
        "parserVersion": { "type": "string" },
        "generatedAt": { "type": "string" },
        "sourceFiles": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "screen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "route", "featureName"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "route": { "type": "string", "minLength": 1 },
        "featureName": { "type": "string", "minLength": 1 },
        "pageType": { "type": ["string", "null"] }
      }
    },
    "angular": {
      "type": "object",
      "additionalProperties": true,
      "required": ["version", "architecture", "component", "template", "forms"],
      "properties": {
        "version": { "type": "integer", "enum": [22] },
        "architecture": { "type": "object" },
        "component": { "type": "object" },
        "template": { "type": "object" },
        "forms": { "type": "object" }
      }
    },
    "permissions": { "type": "array", "items": { "$ref": "#/definitions/permission" } },
    "operations": { "type": "array", "items": { "$ref": "#/definitions/operation" } },
    "fields": { "type": "array", "items": { "type": "object" } },
    "apis": { "type": "array", "items": { "$ref": "#/definitions/api" } },
    "types": { "type": "array", "items": { "$ref": "#/definitions/typeDef" } },
    "actions": { "type": "array", "items": { "$ref": "#/definitions/action" } },
    "store": { "type": "object", "additionalProperties": true },
    "effects": { "type": "array", "items": { "type": "object" } },
    "validations": { "type": "array", "items": { "type": "object" } },
    "mappers": { "type": "array", "items": { "type": "object" } },
    "componentTypes": { "type": "array", "items": { "type": "object" } },
    "implementationRules": { "type": "array", "items": { "type": "object" } },
    "components": { "type": "array", "items": { "$ref": "#/definitions/component" } },
    "forms": { "type": "array", "items": { "type": "object" } },
    "module": { "type": "object" },
    "routing": { "type": "object" },
    "tests": { "type": "array", "items": { "type": "object" } },
    "displayRules": { "type": "array", "items": { "type": "object" } },
    "unsavedChanges": { "type": "object" },
    "concurrentUpdate": { "type": "object" },
    "rules": { "type": "array", "items": { "type": "object" } },
    "warnings": { "type": "array", "items": { "type": "object" } }
  },
  "definitions": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "section", "lineStart", "lineEnd"],
      "properties": {
        "file": { "type": "string" },
        "section": { "type": "string" },
        "lineStart": { "type": "integer" },
        "lineEnd": { "type": "integer" }
      }
    },
    "normalId": {
      "type": "string",
      "pattern": "^[a-z][A-Za-z0-9]*$"
    },
    "typeId": {
      "type": "string",
      "pattern": "^(api|view|payload|common)\\.[a-z][A-Za-z0-9]*$"
    },
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "code", "description", "source"],
      "properties": {
        "id": { "$ref": "#/definitions/normalId" },
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "description": { "type": "string" },
        "source": { "$ref": "#/definitions/source" }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "requiresPermission", "source"],
      "properties": {
        "id": { "$ref": "#/definitions/normalId" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "requiresPermission": { "type": ["string", "null"] },
        "source": { "$ref": "#/definitions/source" }
      }
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "method", "path", "parameters", "source"],
      "properties": {
        "id": { "$ref": "#/definitions/normalId" },
        "name": { "type": "string" },
        "method": { "type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
        "path": { "type": "string", "pattern": "^/" },
        "requestType": { "type": ["string", "null"] },
        "responseType": { "type": ["string", "null"] },
        "permission": { "type": ["string", "null"] },
        "description": { "type": "string" },
        "parameters": { "type": "array", "items": { "type": "object" } },
        "source": { "$ref": "#/definitions/source" }
      }
    },
    "typeDef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "category", "properties", "source"],
      "properties": {
        "id": { "$ref": "#/definitions/typeId" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "properties": { "type": "array", "items": { "type": "object" } },
        "source": { "$ref": "#/definitions/source" }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "source"],
      "properties": {
        "id": { "$ref": "#/definitions/normalId" },
        "name": { "type": "string" },
        "payloadType": { "type": ["string", "null"] },
        "api": { "type": ["string", "null"] },
        "successAction": { "type": ["string", "null"] },
        "failureAction": { "type": ["string", "null"] },
        "relatedOperation": { "type": ["string", "null"] },
        "storeUpdates": { "type": "array", "items": { "type": "string" } },
        "source": { "$ref": "#/definitions/source" }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "className", "selector", "type", "source"],
      "properties": {
        "id": { "$ref": "#/definitions/normalId" },
        "className": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*Component$" },
        "selector": { "type": "string", "pattern": "^app-[a-z0-9-]+$" },
        "type": { "type": "string", "enum": ["container", "presentational", "dialog"] },
        "parent": { "type": ["string", "null"] },
        "storeAccess": { "type": "boolean" },
        "ownsForm": { "type": "boolean" },
        "source": { "$ref": "#/definitions/source" }
      }
    }
  }
}
