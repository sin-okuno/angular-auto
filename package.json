{
  "name": "angular-auto",
  "version": "1.0.0",
  "description": "Markdown screen specifications to Angular 22 + NgRx code generation platform.",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test",
    "spec:parse": "npm --prefix packages/screen-angular-generator run spec:parse --",
    "spec:validate": "npm --prefix packages/screen-angular-generator run spec:validate --",
    "spec:resolve": "npm --prefix packages/screen-angular-generator run spec:resolve --",
    "spec:compile": "npm --prefix packages/screen-angular-generator run spec:compile --",
    "generator:build": "npm --prefix packages/screen-angular-generator run build",
    "generator:test": "npm --prefix packages/screen-angular-generator run test",
    "generator:lint": "npm --prefix packages/screen-angular-generator run lint",
    "generate:angular": "npm --prefix packages/screen-angular-generator run generate:angular --",
    "generate": "npm --prefix packages/screen-angular-generator run generate --",
    "generated:check": "npm --prefix packages/screen-angular-generator run generated:check --"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.2.0",
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/forms": "^18.2.0",
    "@angular/platform-browser": "^18.2.0",
    "@angular/platform-browser-dynamic": "^18.2.0",
    "@angular/router": "^18.2.0",
    "@ngrx/effects": "^18.1.0",
    "@ngrx/store": "^18.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.0",
    "@angular/cli": "^18.2.0",
    "@angular/compiler-cli": "^18.2.0",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.2.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.5.2"
  }
}
